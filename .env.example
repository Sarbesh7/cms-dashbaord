# ==============================================================================
# CSITABMC CMS Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
# Secret key for cryptographic signing (sessions, JWT tokens).
# Either SECRET_KEY or DJANGO_SECRET_KEY is recognized by the application.
# A default is provided for local development; MUST be set to a strong secret in production.
SECRET_KEY=django-insecure-dev-only-key-change-me
# DJANGO_SECRET_KEY=

# Comma-separated list of host/domain names this Django site can serve.
# In production, set to your domain(s), e.g. "cms.csitabmc.com"
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database connection URL (parsed by dj-database-url).
# Local development defaults to SQLite (db.sqlite3) if unset.
# Production requires PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=sqlite:///db.sqlite3

# Comma-separated list of allowed frontend origins for CORS and CSRF requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
# Set to True to store media in Cloudinary (required in production).
# In local development, defaults to False (files saved locally in media/).
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
